if(TARGET Axiolid::axiolid)
  return()
endif()

if(NOT CMAKE_SYSTEM_NAME STREQUAL "@SYSTEM_NAME@")
  message(FATAL_ERROR "This Axiolid package targets @SYSTEM_NAME@, not ${CMAKE_SYSTEM_NAME}")
endif()
if(NOT CMAKE_SYSTEM_PROCESSOR MATCHES "@PROCESSOR_REGEX@")
  message(FATAL_ERROR "This Axiolid package does not support processor ${CMAKE_SYSTEM_PROCESSOR}")
endif()

add_library(Axiolid::axiolid_shared SHARED IMPORTED)
set_target_properties(Axiolid::axiolid_shared PROPERTIES
  IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@SHARED_LOCATION@"
  INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/include"
)
@SHARED_IMPLIB_PROPERTY@
if(APPLE)
  # The dylib's install name is rpath-relative (see axiolid-capi/build.rs);
  # dyld resolves it only through the consumer's LC_RPATH, which CMake does
  # not add for an imported target. Point it at the installed dylib's
  # directory so a plain find_package() consumer runs (#113). Relocating
  # apps override it. (No at-signs here: the packager rejects any left over
  # after template substitution.)
  set_property(TARGET Axiolid::axiolid_shared APPEND PROPERTY INTERFACE_LINK_OPTIONS
    "LINKER:-rpath,${PACKAGE_PREFIX_DIR}/lib")
endif()

add_library(Axiolid::axiolid_static STATIC IMPORTED)
set_target_properties(Axiolid::axiolid_static PROPERTIES
  IMPORTED_LOCATION "${PACKAGE_PREFIX_DIR}/@STATIC_LOCATION@"
  INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/include"
  INTERFACE_LINK_LIBRARIES "@STATIC_LINK_LIBRARIES@"
)

add_library(Axiolid::axiolid INTERFACE IMPORTED)
if(AXIOLID_LINKAGE STREQUAL "STATIC")
  set_property(TARGET Axiolid::axiolid PROPERTY INTERFACE_LINK_LIBRARIES Axiolid::axiolid_static)
else()
  set_property(TARGET Axiolid::axiolid PROPERTY INTERFACE_LINK_LIBRARIES Axiolid::axiolid_shared)
endif()
